*.[ch]pp text eol=lf
*.[ch] text eol=lf
*.[ch]xx text eol=lf
*.cc text eol=lf
*.rc text eol=lf

*.git?* text eol=lf

*.txt text eol=lf
*.cmake text eol=lf

*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf

*.ui text eol=lf
*.qrc text eol=lf
*.ts text eol=lf
*.in text eol=lf

# vcpkg overlay ports feed these to `git apply`, which rejects CRLF context
# lines with "corrupt patch". They must stay LF even on Windows checkouts.
*.patch text eol=lf
*.diff text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
